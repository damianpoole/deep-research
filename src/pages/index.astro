---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import ReportCard from '../components/ReportCard.astro';

const reports = await getCollection('reports');
reports.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Deep Research</title>
  </head>
  <body class="min-h-screen bg-slate-900 text-neutral-100">
    <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
      <header class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-teal-400">Deep Research</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-orange-500 sm:text-5xl">
          Research reports, ready on your tailnet.
        </h1>
        <p class="mt-4 text-base leading-7 text-neutral-400 sm:text-lg">
          Long-form reports from Hermes, rendered for fast reading on desktop or mobile.
        </p>
      </header>

      <section class="mt-10 rounded-3xl border border-neutral-800 bg-neutral-900/60 p-4 sm:p-5">
        <label class="block text-sm font-medium text-neutral-300" for="report-search">Search reports</label>
        <input
          id="report-search"
          type="search"
          placeholder="Filter by title or excerpt"
          class="mt-3 w-full rounded-2xl border border-neutral-700 bg-neutral-950 px-4 py-3 text-base text-white outline-none transition placeholder:text-neutral-500 focus:border-teal-400"
        />
      </section>

      <section class="mt-6">
        <div class="mb-4 flex items-center justify-between gap-4">
          <p class="text-sm text-neutral-400">
            <span id="report-count">{reports.length}</span> report{reports.length === 1 ? '' : 's'} available
          </p>
          <p id="empty-state" class="hidden text-sm text-neutral-500">No reports match your search.</p>
        </div>

        <div id="report-list" class="space-y-4">
          {reports.map((report) => (
            <ReportCard
              title={report.data.title}
              slug={report.id}
              date={report.data.date}
              excerpt={report.data.excerpt}
            />
          ))}
        </div>
      </section>
    </main>

    <script>
      const searchInput = document.querySelector('#report-search');
      const cards = Array.from(document.querySelectorAll('[data-report-card]'));
      const emptyState = document.querySelector('#empty-state');
      const count = document.querySelector('#report-count');

      if (searchInput instanceof HTMLInputElement && emptyState instanceof HTMLElement && count instanceof HTMLElement) {
        const update = () => {
          const query = searchInput.value.trim().toLowerCase();
          let visible = 0;

          for (const card of cards) {
            if (!(card instanceof HTMLElement)) continue;
            const haystack = card.dataset.search ?? '';
            const matches = haystack.includes(query);
            card.classList.toggle('hidden', !matches);
            if (matches) visible += 1;
          }

          count.textContent = String(visible);
          emptyState.classList.toggle('hidden', visible !== 0);
        };

        searchInput.addEventListener('input', update);
      }
    </script>
  </body>
</html>

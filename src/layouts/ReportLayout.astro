---
import '../styles/global.css';

interface Props {
  title: string;
  date: Date;
}

const { title, date } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} • Deep Research</title>
  </head>
  <body class="min-h-screen bg-slate-900 text-neutral-100">
    <main class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
      <a href="/" class="inline-flex items-center gap-2 text-sm text-neutral-400 transition hover:text-neutral-100">
        <span aria-hidden="true">←</span>
        <span>Back to reports</span>
      </a>

      <header class="mt-6 border-b border-neutral-800 pb-6">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-pink-400">Deep Research</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-pink-500 sm:text-4xl">{title}</h1>
        <time class="mt-3 block text-sm text-neutral-400" datetime={date.toISOString()}>
          {date.toLocaleDateString('en-GB', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </header>

      <article class="report-content mt-8">
        <slot />
      </article>
    </main>
  </body>
</html>

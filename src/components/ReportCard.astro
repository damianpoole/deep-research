---
interface Props {
  title: string;
  slug: string;
  date: Date;
  excerpt?: string;
}

const { title, slug, date, excerpt } = Astro.props;
const formattedDate = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const searchableText = `${title} ${excerpt ?? ''}`.toLowerCase();
---

<a
  href={`/reports/${slug}`}
  class="group block rounded-2xl border border-neutral-800 bg-neutral-900/80 p-5 transition duration-200 hover:border-teal-500/40 hover:bg-neutral-900 hover:shadow-[0_0_0_1px_rgba(45,212,191,0.15)]"
  data-report-card
  data-search={searchableText}
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold text-white transition group-hover:text-teal-300 sm:text-xl">{title}</h2>
      <p class="mt-2 text-sm leading-6 text-neutral-400">
        {excerpt ?? 'Open report'}
      </p>
    </div>
    <span class="shrink-0 rounded-full border border-neutral-700 px-3 py-1 text-xs font-medium uppercase tracking-[0.18em] text-neutral-400">
      {formattedDate}
    </span>
  </div>
</a>
